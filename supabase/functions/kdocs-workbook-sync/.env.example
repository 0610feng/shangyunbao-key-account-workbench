# 仅配置到 Supabase Edge Function Secrets；不要放进 index.html、config.js 或 Git 仓库。
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY

# 从目标金山云文档的 AirScript 编辑器复制“同步执行 Webhook”和脚本令牌。
WPS_AIRSCRIPT_WEBHOOK_URL=https://www.kdocs.cn/api/v3/ide/file/FILE_ID/script/SCRIPT_ID/sync_task
WPS_AIRSCRIPT_TOKEN=YOUR_PRIVATE_AIRSCRIPT_TOKEN

# 多个来源用英文逗号分隔；不要填写 *。
WORKBENCH_ALLOWED_ORIGINS=https://0610feng.github.io

# 上线初期保持 false。只有已核验并seed历史计数器后，才可改为 true。
KDOCS_ALLOW_TICKET_BACKFILL=false
